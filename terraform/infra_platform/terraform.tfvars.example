# Copier en terraform.tfvars (non versionné).
# infra_platform : cluster K8s pour outils plateforme (Vault, Kafka, etc.).

infra_name = "platform"
network_external_id   = "0f9c3806-bd21-490f-918d-4a6d1c648489"
network_external_name = "ext-floating1"

ssh_public_key_default_user = "ssh-rsa AAAA... ton-user@machine"
vm_ssh_user = "ubuntu"

# VPN : OpenVPN sur le master (accès cluster via VPN)
deploy_vpn             = false
vpn_user_list          = []

# Cluster K8s plateforme
deploy_k8s                    = true
cluster_subnet_cidr           = "10.0.10.0/24"
k8s_worker_count              = 1
k8s_master_floating_ip        = true
run_k8s_ansible_after_apply   = true
install_vault                 = false   # true : installer Vault via Helm après apply
install_mongodb               = false   # true : installer MongoDB via Helm après apply (renseigner auth.rootPassword dans tools/mongodb/values.yaml)
install_argocd                = false   # true : installer Argo CD via Helm après apply
